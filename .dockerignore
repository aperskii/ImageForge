# Keep the build context to what the Dockerfiles actually need: everything here
# would otherwise be uploaded to the daemon on every build, and anything copied
# in becomes part of an image layer.

.git
.github
.gitignore
.gitattributes
.golangci.yml

# Local runtime state and build output.
.data
bin
dist

# The front-end is served by its own container from a bind mount, and
# node_modules is both enormous and platform-specific.
web/node_modules
web/dist
node_modules

# Nothing the binaries need at runtime.
README.md
web/README.md
deployments/terraform
docker-compose.yml
docker-compose.*.yml
Makefile

# Secrets must never reach a layer, whatever else changes here.
.env
.env.*
*.pem
*.key
